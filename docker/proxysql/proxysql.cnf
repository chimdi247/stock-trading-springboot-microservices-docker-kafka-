# =====================================================================
# ProxySQL — connection pooling / multiplexing in front of MySQL
#
#   services ──► proxysql:6033 (MySQL protocol) ──► mysql:3306
#   admin console   : proxysql:6032  (mysql -h127.0.0.1 -P6032 -uradmin -pradmin)
#   prometheus      : proxysql:6070/metrics   (built-in exporter)
#
# Hostgroup 0 = writer (the only backend). To load-balance reads, add a
# replica to hostgroup 10, a mysql_replication_hostgroups entry and a
# query rule  ^SELECT -> 10  (see README "Scaling the database tier").
# =====================================================================
datadir="/var/lib/proxysql"
errorlog_file="/var/lib/proxysql/proxysql.log"

admin_variables=
{
    # radmin allows remote admin access from other containers / the host
    admin_credentials="admin:admin;radmin:radmin"
    mysql_ifaces="0.0.0.0:6032"

    # Built-in Prometheus exporter -> http://proxysql:6070/metrics
    restapi_enabled=true
    restapi_port=6070
    prometheus_memory_metrics_interval=60
}

mysql_variables=
{
    threads=4
    max_connections=2048
    interfaces="0.0.0.0:6033"
    server_version="8.0.36"
    default_schema="information_schema"
    stacksize=1048576
    poll_timeout=2000
    have_compress=true
    commands_stats=true
    sessions_sort=true

    # Connection pooling / multiplexing: many app connections share few backend ones
    multiplexing=true
    connection_max_age_ms=0
    free_connections_pct=10
    max_transaction_time=14400000
    connect_timeout_server=3000
    connect_timeout_server_max=10000
    connect_retries_on_failure=10
    shun_on_failures=5
    shun_recovery_time_sec=10
    ping_interval_server_msec=120000
    ping_timeout_server=500

    # Backend health monitoring (user created in docker/mysql/init/01-*.sql)
    monitor_username="monitor"
    monitor_password="monitor"
    monitor_connect_interval=10000
    monitor_ping_interval=10000
    monitor_history=60000

    # Treat slow queries as slow after 1s (feeds proxysql_slow_queries_total)
    long_query_time=1000
}

# Backend MySQL servers --------------------------------------------------
mysql_servers =
(
    {
        address="mysql"
        port=3306
        hostgroup=0
        max_connections=100          # pool ceiling towards MySQL (dashboard variable "max_backend_conns")
        max_replication_lag=10
        weight=1
        comment="mysql-primary"
    }
)

# Application users -------------------------------------------------------
mysql_users =
(
    {
        username="trading_app"
        password="trading_pass"
        default_hostgroup=0
        max_connections=500
        transaction_persistent=1     # keep a transaction on the same backend connection
        active=1
    }
)

mysql_query_rules =
(
)
