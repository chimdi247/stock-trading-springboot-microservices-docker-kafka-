# ─────────────────────────────────────────────────────────────────────
# Compose environment — edit as needed, then:  docker compose up -d --build
# ─────────────────────────────────────────────────────────────────────

# Must match the secret used by user-service (signs) and api-gateway (verifies)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# Optional: enables real Claude fraud checks. Empty = rule-based fallback.
ANTHROPIC_API_KEY=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Alert e-mail (Grafana-managed alerts). Defaults point at the bundled Mailpit
# catch-all SMTP server — read the mails at http://localhost:8025.
# To use a real provider, change these (e.g. smtp.gmail.com / 587 / STARTTLS).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=chimdi247@gmail.com
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=grafana-alerts@trading.com
SMTP_FROM_NAME=Trading Platform Alerts
SMTP_STARTTLS_POLICY=MandatoryStartTLS
SMTP_SKIP_VERIFY=true
ALERT_EMAIL_TO=shimdi247@gmail.com

# Alert thresholds (percent)
ALERT_CPU_THRESHOLD=40
ALERT_MEM_THRESHOLD=40
